{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {"deploymentEnabled": {"codex/course-integrity-4-7-2": false}},
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "same-origin"}]},
    {"source": "/", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/course.json", "headers": [{"key": "Cache-Control", "value": "no-cache"}]},
    {"source": "/assets/(.*)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
  ]
}
